COMMERCE_PROVIDER=mock
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only: nunca usar NEXT_PUBLIC_ para tokens
SHOPIFY_STORE_DOMAIN=
SHOPIFY_PRIVATE_STOREFRONT_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-04
# Shopify CLI Admin API: autenticación local y scopes read_products, write_products, read_inventory, write_inventory.
SHOPIFY_ADMIN_API_VERSION=2026-04
# Contacto oficial: completar solo al confirmar el canal
NEXT_PUBLIC_CONTACT_EMAIL=

# Estimación informativa Envia.com (solo servidor; solo se muestra el plazo).
ENVIA_TOKEN=
ENVIA_ORIGIN_NAME=
ENVIA_ORIGIN_PHONE=
ENVIA_ORIGIN_STREET=
ENVIA_ORIGIN_NUMBER=
ENVIA_ORIGIN_CITY=
ENVIA_ORIGIN_STATE=
ENVIA_ORIGIN_POSTAL_CODE=
ENVIA_PREPARATION_HOURS=1
ENVIA_CUTOFF_TIME=
ENVIA_CACHE_TTL_SECONDS=21600
ENVIA_COURIER_PRIORITY=starken,blueexpress,chilexpress
ENVIA_PACKAGE_CONTENT=Joyería
ENVIA_PACKAGE_LENGTH_CM=20
ENVIA_PACKAGE_WIDTH_CM=20
ENVIA_PACKAGE_HEIGHT_CM=20
ENVIA_PACKAGE_WEIGHT_KG=0.4
ENVIA_PACKAGE_AMOUNT=1
